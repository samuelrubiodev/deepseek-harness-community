# ==============================================================================
# DEEPSEEK HARNESS COMMUNITY FORK - EXAMPLE CONFIGURATION (.env)
# ==============================================================================
# Copy this file to `.env` in the root of the project to configure your Docker
# container or server deployment:
#   cp .env.example .env
#
# ARCHITECTURAL SECURITY NOTE:
# DeepSeek Harness uses a layered environment loader (loadLayeredEnv). Variables
# starting with `DSH_` or controlling network/bootstrap are treated as process-only
# bootstrap variables and MUST NOT be placed in workspace `.env` files (/workspace/.env).
# Defining them here for Docker Compose injects them as native process environment
# variables (process.env) into the container, which is the secure, supported method.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK BINDING & PORT
# ------------------------------------------------------------------------------
# IP address the web server binds to.
# - In Docker: Use `0.0.0.0` to allow port forwarding from the host machine.
# - In direct local execution: Use `127.0.0.1` (or `0.0.0.0` for LAN access).
DSH_HOST=0.0.0.0

# TCP listening port for the web application (HTTP and WebSocket).
# (Default: 3080)
DSH_PORT=3080

# ------------------------------------------------------------------------------
# 2. TRUST FENCE & LAN / DOMAIN ACCESS
# ------------------------------------------------------------------------------
# Comma-separated list of hostnames, FQDNs, or IP addresses permitted to access
# the DeepSeek Harness web interface and API.
#
# Any HTTP or WebSocket request whose `Host` header is neither loopback (127.0.0.1, localhost)
# nor listed here will be rejected with HTTP 403 Forbidden to prevent DNS Rebinding attacks.
# Furthermore, clients connecting from these trusted hosts gain persistent access
# to the Settings UI panel.
#
# Examples:
#   DSH_TRUSTED_HOSTS=192.168.1.50,harness.local
#   DSH_TRUSTED_HOSTS=192.168.1.100:3080,ai.company.lan,harness.lan
DSH_TRUSTED_HOSTS=

# ------------------------------------------------------------------------------
# 3. REVERSE PROXY MODE (NGINX, CADDY, TRAEFIK, CLOUDFLARE)
# ------------------------------------------------------------------------------
# Enables evaluation of standard reverse proxy headers:
#   - `X-Forwarded-Host`: Original host requested by the client.
#   - `X-Forwarded-Proto`: Original protocol (http or https).
#
# If running DeepSeek Harness behind a reverse proxy (with or without TLS termination):
# 1. Set DSH_REVERSE_PROXY=true
# 2. Add the proxy hostname/domain to DSH_TRUSTED_HOSTS (e.g., DSH_TRUSTED_HOSTS=ai.mydomain.com)
# 3. Ensure your reverse proxy forwards `X-Forwarded-Host` and `X-Forwarded-Proto`.
#
# Allowed values: true, false (Default: false)
DSH_REVERSE_PROXY=false

# ------------------------------------------------------------------------------
# 4. BROWSER AUTHENTICATION (TOKEN)
# ------------------------------------------------------------------------------
# Access mode for the Web UI and its /api:
#   token  (default) — the first visit must carry /?token=<launch-token>; the
#          browser then gets a signed session cookie (30 days) and every later
#          request is cookie-based.
#   none   — no token, no cookie: any request whose Host passes
#          DSH_TRUSTED_HOSTS (section 2) reaches the full application. This
#          exposes the agent's code-execution tools to every host on that
#          list; use it only on networks you fully control.
# Allowed values: token, none (Default: token)
DSH_AUTH_MODE=token

# Fixed access token replacing the random per-process launch token. When set,
# the sign-in URL `http://<host>:<port>/?token=<THIS-VALUE>` works forever:
# the same link after every container restart, no log reading needed. The
# session-cookie flow continues normally after that first visit.
# Leave empty to keep the upstream behavior (a new random token each start).
# Choose a long random secret, for example: `openssl rand -base64 32 | tr '+/' '-_'`.
# The token value itself is never written to logs.
DSH_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 5. CREDENTIALS & LLM PROVIDER (DEEPSEEK API)
# ------------------------------------------------------------------------------
# API key for the official DeepSeek API service.
# If omitted here, you can configure it interactively through the onboarding dialog
# or the Settings panel in the web interface.
DEEPSEEK_API_KEY=

# Base URL for the DeepSeek API (optional).
# Default: https://api.deepseek.com
# Use only if connecting through a custom endpoint, API gateway, or compatible proxy.
DEEPSEEK_BASE_URL=

# ------------------------------------------------------------------------------
# 6. TELEMETRY & PRIVACY (DENIED BY DEFAULT)
# ------------------------------------------------------------------------------
# Every telemetry channel and every non-inference contribution to official
# DeepSeek API requests is denied by default, and no collector URL is baked in.
# Set an opt-in variable below to enable one. A non-empty DSH_TELEMETRY_DISABLED
# overrides all of them and always wins.
#
# The DeepSeek inference path is unaffected: api.deepseek.com requests, the
# harness identity request headers, and user-agent behave the same either way.

# Opt in to the OpenTelemetry channels. Session telemetry additionally needs
# DSH_TELEMETRY_MODE=FEEDBACK_ONLY and DSH_TELEMETRY_OTLP_URL; Desktop product
# analytics additionally needs DSH_PRODUCT_ANALYTICS_OTLP_URL.
DSH_TELEMETRY_ENABLED=

# Session telemetry sharing policy.
# - DISABLED (default): no OTel pipeline is constructed.
# - FEEDBACK_ONLY: releases the canonical session prefix only after new explicit
#   feedback. FULL is rejected.
DSH_TELEMETRY_MODE=

# OTLP logs endpoint for session telemetry. An uploading mode requires it, and
# an opted-in process without it fails at load. There is no default.
DSH_TELEMETRY_OTLP_URL=

# OTLP logs endpoint for Desktop product analytics. Required to opt in.
DSH_PRODUCT_ANALYTICS_OTLP_URL=

# Opt in to attaching the canonical session log to official DeepSeek requests.
DSH_SESSION_LOG_UPLOAD=

# Opt in to attaching the installed plugin inventory to official DeepSeek requests.
DSH_PLUGIN_INVENTORY_UPLOAD=

# Overrides every opt-in above. Any non-empty value denies, including '0' and 'false'.
DSH_TELEMETRY_DISABLED=

# ------------------------------------------------------------------------------
# 7. CONTAINER PERSISTENCE PATHS (DOCKER VOLUMES)
# ------------------------------------------------------------------------------
# Root directory for durable DeepSeek Harness state (profiles, sessions, credentials).
# In the Docker container, this points to the mounted `/data` volume.
DSH_HOME=/data

# Default working directory where the agent operates and executes tools.
# In the Docker container, this points to the mounted `/workspace` volume.
WORKSPACE_DIR=/workspace
