# ==============================================================================
# DeepSeek Harness - Production Reference Caddy Configuration
# ==============================================================================
# Features:
# 1. Automatic TLS certificate issuance and renewals (Let's Encrypt / ZeroSSL).
# 2. Transparent WebSocket upgrade handling.
# 3. HTTP/2 and HTTP/3 (QUIC) enabled by default.
# 4. Automated forwarding of X-Forwarded-For, X-Forwarded-Proto, and X-Forwarded-Host.
# ==============================================================================

harness.example.com {
    # In production with a public domain, Caddy handles Let's Encrypt automatically.
    # For local LAN or self-signed testing without a public domain, uncomment:
    # tls internal

    reverse_proxy harness:3080 {
        # Preserve original client authority
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto https

        # Disable response buffering for immediate token streaming
        flush_interval -1
    }
}
